#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Binary files should be left untouched
*.jar           binary

# Server scripts run on Linux
scripts/backup/* text eol=lf

# Plugin resources are packed into the jar as they are on disk: keep them LF everywhere, so the jar is the same
# whichever machine builds it (the tycoon compares its sample template.yml byte for byte).
src/main/resources/** text eol=lf
